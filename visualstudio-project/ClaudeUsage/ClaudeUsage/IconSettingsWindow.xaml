<ui:FluentWindow x:Class="ClaudeUsage.IconSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Icon Settings"
        Width="560"
        SizeToContent="Height"
        MaxHeight="900"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <!-- Default Fluent RadioButton: bullet on the left, whole control clickable.
             Just give it room and let the title/description be its content. -->
        <Style x:Key="StyleRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="GroupName" Value="IconStyle"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBar" Grid.Row="0" Padding="20,14,12,10"
                Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Image24" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" x:Name="HeaderTitle" Text="Icon Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                           Padding="8" ToolTip="Close" Click="CloseButton_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="820" Padding="20,0,20,18">
            <StackPanel>

                <!-- ============ Icon style ============ -->
                <TextBlock x:Name="StyleHeader" Style="{StaticResource SectionHeader}" Text="Icon style" Margin="2,4,0,8"/>

                <RadioButton x:Name="BadgeRadio" Style="{StaticResource StyleRadio}" Tag="Badge" Checked="StyleRadio_Checked">
                    <StackPanel>
                        <TextBlock x:Name="BadgeTitle" Style="{StaticResource CardTitle}" Text="Badge"/>
                        <TextBlock x:Name="BadgeDesc" Style="{StaticResource CardDesc}" Text="The original icon: a number with a frame and a colored status dot."/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NumberRadio" Style="{StaticResource StyleRadio}" Tag="Number" Checked="StyleRadio_Checked">
                    <StackPanel>
                        <TextBlock x:Name="NumberTitle" Style="{StaticResource CardTitle}" Text="Number"/>
                        <TextBlock x:Name="NumberDesc" Style="{StaticResource CardDesc}" Text="Large bold percentage that fills the icon. Easiest to read at a glance."/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RingRadio" Style="{StaticResource StyleRadio}" Tag="Ring" Checked="StyleRadio_Checked">
                    <StackPanel>
                        <TextBlock x:Name="RingTitle" Style="{StaticResource CardTitle}" Text="Ring"/>
                        <TextBlock x:Name="RingDesc" Style="{StaticResource CardDesc}" Text="Circular progress ring that fills as usage rises."/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="BarRadio" Style="{StaticResource StyleRadio}" Tag="Bar" Checked="StyleRadio_Checked">
                    <StackPanel>
                        <TextBlock x:Name="BarTitle" Style="{StaticResource CardTitle}" Text="Bar"/>
                        <TextBlock x:Name="BarDesc" Style="{StaticResource CardDesc}" Text="Vertical gauge that fills from the bottom as usage rises."/>
                    </StackPanel>
                </RadioButton>

                <!-- ============ Severity thresholds ============ -->
                <TextBlock x:Name="ThresholdsHeader" Style="{StaticResource SectionHeader}" Text="Severity thresholds"/>

                <ui:CardControl Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock x:Name="WarnTitle" Style="{StaticResource CardTitle}" Text="Warning (yellow)"/>
                            <TextBlock x:Name="WarnDesc" Style="{StaticResource CardDesc}" Text="Turn the icon yellow at or above this usage."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="220">
                        <Slider x:Name="WarnSlider" Width="160" VerticalAlignment="Center"
                                Minimum="30" Maximum="95" SmallChange="1" LargeChange="5"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="WarnSlider_ValueChanged"/>
                        <TextBlock x:Name="WarnValueText" Text="≥ 70%" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="44"/>
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock x:Name="CritTitle" Style="{StaticResource CardTitle}" Text="Critical (red)"/>
                            <TextBlock x:Name="CritDesc" Style="{StaticResource CardDesc}" Text="Turn the icon red at or above this usage."/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="220">
                        <Slider x:Name="CritSlider" Width="160" VerticalAlignment="Center"
                                Minimum="50" Maximum="100" SmallChange="1" LargeChange="5"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="CritSlider_ValueChanged"/>
                        <TextBlock x:Name="CritValueText" Text="≥ 90%" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="44"/>
                    </StackPanel>
                </ui:CardControl>

                <TextBlock x:Name="OrderNote" FontSize="12" Foreground="#E0A030"
                           TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"
                           Text="Warning should be below Critical, otherwise the yellow range never shows."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
